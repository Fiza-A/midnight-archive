# Server-only (preferred — set in Netlify Environment variables)
SECRET_CODE=your-secret-code

# Netlify fallback: set this if the API route cannot read SECRET_CODE (redeploy after adding)
# NEXT_PUBLIC_SECRET_CODE=your-secret-code

# Optional personalization
NEXT_PUBLIC_PARTNER_NAME=My Love
NEXT_PUBLIC_YOUR_NAME=Me
NEXT_PUBLIC_RELATIONSHIP_START=2023-01-15

# Optional debug overlay
NEXT_PUBLIC_DEBUG=false
